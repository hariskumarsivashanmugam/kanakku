# Copy this file to .env and fill in your own values. Never commit .env.

# --- Claude (Anthropic API) ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- PayPal (sandbox) ---
# From https://developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Data mode:
#   auto - use your PayPal sandbox if the keys above are set, otherwise demo data (default)
#   live - always use your PayPal sandbox
#   demo - always use the built-in demo store (no PayPal keys needed)
DATA_MODE=auto

# Optional: the sandbox test card `npm run seed` pays with. Defaults to one of PayPal's
# published sandbox test cards (Visa 4012000033330026). See PayPal's "Card testing" page.
SEED_TEST_CARD_NUMBER=
SEED_TEST_CARD_EXPIRY=2030-12

# --- Optional extras ---
# Channel3 product data for the price check (free key: trychannel3.com/developers, promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=
# PayPal emails the Workshop pays (comma-separated, in order: Selvi, Fatima, Ramesh, Arjun, Kamala).
# Use your sandbox personal accounts so payouts complete; example.com addresses stay "unclaimed".
ARTISAN_EMAILS=
# From `npm run webhook -- --url=https://your-public-url` (needed for live PayPal events)
PAYPAL_WEBHOOK_ID=
# When deployed publicly: a password for opening Kanakku, and a secret for the Render workflow
APP_PASSWORD=
AUTOPILOT_SECRET=
# Where Kanakku keeps its own files (orders it created, workshop, autopilot). Default: ./.kanakku
KANAKKU_DIR=

PORT=8787
